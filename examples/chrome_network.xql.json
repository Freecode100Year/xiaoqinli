{
  "kind": "Program",
  "declarations": [
    {
      "kind": "StructDecl",
      "name": "QueryInfo",
      "fields": [
        { "name": "active", "type": { "kind": "Bool" } },
        { "name": "currentWindow", "type": { "kind": "Bool" } }
      ]
    },
    {
      "kind": "StructDecl",
      "name": "FetchHeaders",
      "fields": [
        { "name": "accept", "type": { "kind": "String" } }
      ]
    },
    {
      "kind": "StructDecl",
      "name": "FetchOptions",
      "fields": [
        { "name": "headers", "type": { "kind": "FetchHeaders" } }
      ]
    },
    {
      "kind": "FunctionDecl",
      "name": "getHostname",
      "params": [
        { "name": "url", "type": { "kind": "String" } }
