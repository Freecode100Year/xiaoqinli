                      "kind": "CallExpr",
                      "callee": "printf",
                      "args": [
                        { "kind": "Literal", "valueType": "String", "value": "往返延迟估算 (RTT): %s ms\n" },
                        { "kind": "MemberExpr", "object": { "kind": "Ident", "name": "conn" }, "field": "rtt" }
                      ]
                    }
                  },
                  {
                    "kind": "VarDecl",
                    "name": "hostname",
                    "type": { "kind": "String" },
                    "value": {
                      "kind": "CallExpr",
                      "callee": "getHostname",
                      "args": [
                        { "kind": "MemberExpr", "object": { "kind": "Ident", "name": "tab" }, "field": "url" }
                      ]
                    }
                  },
                  {
                    "kind": "ExprStmt",
                    "expr": {
                      "kind": "CallExpr",
                      "callee": "fetchDnsInfo",
                      "args": [
                        { "kind": "Ident", "name": "hostname" }
