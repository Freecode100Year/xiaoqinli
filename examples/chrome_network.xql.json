      "returnType": { "kind": "String" },
      "effects": ["pure"],
      "grant": [],
      "body": [
        {
          "kind": "ReturnStmt",
          "value": { "kind": "Ident", "name": "url" }
        }
      ]
    },
    {
      "kind": "FunctionDecl",
      "name": "fetchDnsInfo",
      "params": [
        { "name": "domain", "type": { "kind": "String" } }
      ],
      "returnType": { "kind": "Void" },
      "effects": ["network"],
      "grant": [],
      "body": [
        {
          "kind": "VarDecl",
          "name": "queryUrl",
          "type": { "kind": "String" },
          "value": {
            "kind": "BinaryExpr",
            "op": "+",
            "left": {
              "kind": "BinaryExpr",
              "op": "+",
              "left": { "kind": "Literal", "valueType": "String", "value": "https://cloudflare-dns.com/dns-query?name=" },
              "right": { "kind": "Ident", "name": "domain" }
            },
            "right": { "kind": "Literal", "valueType": "String", "value": "&type=A" }
          }
        },
        {
          "kind": "VarDecl",
          "name": "opts",
          "type": { "kind": "FetchOptions" },
          "value": {
            "kind": "StructLit",
            "typeName": "FetchOptions",
            "fields": [
              {
                "name": "headers",
                "value": {
                  "kind": "StructLit",
                  "typeName": "FetchHeaders",
                  "fields": [
                    { "name": "accept", "value": { "kind": "Literal", "valueType": "String", "value": "application/dns-json" } }
                  ]
                }
              }
            ]
          }
        },
        {
          "kind": "VarDecl",
          "name": "t0",
          "type": { "kind": "Int" },
          "value": { "kind": "CallExpr", "callee": "Date.now", "args": [] }
        },
        {
          "kind": "VarDecl",
          "name": "p",
          "value": {
            "kind": "CallExpr",
            "callee": "fetch",
            "args": [
              { "kind": "Ident", "name": "queryUrl" },
              { "kind": "Ident", "name": "opts" }
            ]
          }
        },
        {
          "kind": "ExprStmt",
          "expr": {
            "kind": "CallExpr",
            "callee": "p.then",
            "args": [
              {
                "kind": "Lambda",
                "params": [
                  { "name": "res" }
                ],
                "body": [
                  {
                    "kind": "VarDecl",
                    "name": "p2",
                    "value": { "kind": "CallExpr", "callee": "res.json", "args": [] }
                  },
                  {
                    "kind": "ExprStmt",
                    "expr": {
                      "kind": "CallExpr",
                      "callee": "p2.then",
                      "args": [
                        {
                          "kind": "Lambda",
                          "params": [
                            { "name": "data" }
                          ],
                          "body": [
                            {
                              "kind": "VarDecl",
                              "name": "t1",
                              "type": { "kind": "Int" },
                              "value": { "kind": "CallExpr", "callee": "Date.now", "args": [] }
                            },
                            {
                              "kind": "VarDecl",
                              "name": "latency",
                              "type": { "kind": "Int" },
                              "value": {
                                "kind": "BinaryExpr",
                                "op": "-",
                                "left": { "kind": "Ident", "name": "t1" },
                                "right": { "kind": "Ident", "name": "t0" }
                              }
                            },
                            {
                              "kind": "ExprStmt",
                              "expr": {
                                "kind": "CallExpr",
                                "callee": "printf",
                                "args": [
                                  { "kind": "Literal", "valueType": "String", "value": "\n--- DNS 与 延迟分析 ---\n" }
                                ]
                              }
                            },
                            {
                              "kind": "ExprStmt",
                              "expr": {
                                "kind": "CallExpr",
                                "callee": "printf",
                                "args": [
                                  { "kind": "Literal", "valueType": "String", "value": "目标域名: %s\n" },
                                  { "kind": "Ident", "name": "domain" }
                                ]
                              }
                            },
                            {
                              "kind": "ExprStmt",
                              "expr": {
                                "kind": "CallExpr",
                                "callee": "printf",
                                "args": [
                                  { "kind": "Literal", "valueType": "String", "value": "解析 DNS + 往返延迟: %s ms\n" },
                                  { "kind": "Ident", "name": "latency" }
                                ]
                              }
                            },
                            {
                              "kind": "VarDecl",
                              "name": "answer",
                              "value": {
                                "kind": "MemberExpr",
                                "object": { "kind": "Ident", "name": "data" },
                                "field": "Answer"
                              }
                            },
                            {
                              "kind": "IfStmt",
                              "cond": { "kind": "Ident", "name": "answer" },
                              "then": [
                                {
                                  "kind": "VarDecl",
                                  "name": "first",
                                  "value": {
                                    "kind": "IndexExpr",
                                    "target": { "kind": "Ident", "name": "answer" },
                                    "index": { "kind": "Literal", "valueType": "Int", "value": 0 }
                                  }
                                },
                                {
                                  "kind": "ExprStmt",
                                  "expr": {
                                    "kind": "CallExpr",
                                    "callee": "printf",
                                    "args": [
                                      { "kind": "Literal", "valueType": "String", "value": "DNS A记录解析 IP: %s\n" },
                                      { "kind": "MemberExpr", "object": { "kind": "Ident", "name": "first" }, "field": "data" }
                                    ]
                                  }
                                }
                              ],
                              "else": [
                                {
                                  "kind": "ExprStmt",
                                  "expr": {
                                    "kind": "CallExpr",
                                    "callee": "println",
                                    "args": [
                                      { "kind": "Literal", "valueType": "String", "value": "未检测到 DNS A记录解析。" }
                                    ]
                                  }
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    },
    {
      "kind": "FunctionDecl",
      "name": "main",
      "params": [],
      "returnType": { "kind": "Void" },
      "effects": ["state", "network"],
      "grant": [],
